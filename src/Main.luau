-- Executor compatibility. Every UNC function this build may reach gets a
-- harmless fallback when the executor does not ship it, so the hub and the
-- bundled WindUI never call a nil. Real functions always win: each slot is
-- only filled when it is still empty. Runs before the hub chunk so both the
-- hub and WindUI see the same globals.
do
    local g = (type(getgenv) == "function" and getgenv()) or _G
    local function put(name, value)
        if g[name] == nil then g[name] = value end
        if rawget(_G, name) == nil then _G[name] = value end
    end
    local function noop() end
    local function identity(value) return value end

    put("getgenv", function() return g end)
    put("getrenv", function() return g end)
    put("getreg", function() return {} end)
    put("getgc", function() return {} end)
    put("cloneref", identity)
    put("clonereference", identity)
    put("compareinstances", function(a, b) return rawequal(a, b) end)
    put("gethui", function()
        local ok, core = pcall(function() return game:GetService("CoreGui") end)
        if ok and core then return core end
