    put("getthreadidentity", function() return 8 end)
    put("get_thread_identity", function() return 8 end)
    put("setfpscap", noop)
    put("consoleclear", noop)
    put("rconsoleclear", noop)
    put("mousemoverel", noop)
    put("mouse1click", noop)
    put("mouse1press", noop)
    put("mouse1release", noop)
