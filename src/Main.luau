-- Executor compatibility. Every UNC function this build may reach gets a
-- harmless fallback when the executor does not ship it, so the hub and the
-- bundled WindUI never call a nil. Real functions always win: each slot is
-- only filled when it is still empty. Runs before the hub chunk so both the
-- hub and WindUI see the same globals.
do
    local g = (type(getgenv) == "function" and getgenv()) or _G
    local function put(name, value)
        if g[name] == nil then g[name] = value end
        if rawget(_G, name) == nil then _G[name] = value end
    end
    local function noop() end
    local function identity(value) return value end

    put("getgenv", function() return g end)
    put("getrenv", function() return g end)
    put("getreg", function() return {} end)
    put("getgc", function() return {} end)
    put("cloneref", identity)
    put("clonereference", identity)
    put("compareinstances", function(a, b) return rawequal(a, b) end)
    put("gethui", function()
        local ok, core = pcall(function() return game:GetService("CoreGui") end)
        if ok and core then return core end
        local players = game:GetService("Players")
        return players.LocalPlayer:WaitForChild("PlayerGui")
    end)
    put("protectgui", noop)
    put("protect_gui", noop)
    put("ProtectGui", noop)
    put("getconnections", function() return {} end)
    put("firetouchinterest", noop)
    put("fireproximityprompt", noop)
    put("fireclickdetector", noop)
    put("firesignal", noop)
    put("getcustomasset", function(path)
        local text = tostring(path)
        if text:sub(1, 8) == "rbxasset" then return text end
        return ""
    end)
    put("hookfunction", function(target) return target end)
    put("replaceclosure", function(target) return target end)
    put("restorefunction", noop)
    put("hookmetamethod", function() return noop end)
    put("getrawmetatable", function(value) return getmetatable(value) end)
    put("setreadonly", function() return false end)
    put("isreadonly", function() return true end)
    put("checkcaller", function() return false end)
    put("isexecutorclosure", function() return false end)
    put("newcclosure", identity)
    put("clonefunction", identity)
    put("islclosure", function() return true end)
    put("iscclosure", function() return false end)
    put("is_sirhurt_closure", function() return false end)
    put("queue_on_teleport", noop)
    put("queue_teleport", noop)
    put("identifyexecutor", function() return "unknown", "unknown" end)
    put("getexecutorname", function() return "unknown" end)
    put("getnilinstances", function() return {} end)
    put("getinstances", function() return {} end)
    put("getloadedmodules", function() return {} end)
