    put("setreadonly", function() return false end)
    put("isreadonly", function() return true end)
    put("checkcaller", function() return false end)
    put("isexecutorclosure", function() return false end)
    put("newcclosure", identity)
    put("clonefunction", identity)
    put("islclosure", function() return true end)
    put("iscclosure", function() return false end)
    put("is_sirhurt_closure", function() return false end)
    put("queue_on_teleport", noop)
    put("queue_teleport", noop)
    put("identifyexecutor", function() return "unknown", "unknown" end)
    put("getexecutorname", function() return "unknown" end)
