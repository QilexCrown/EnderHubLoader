				BorderSizePixel = 0,
				Position = UDim2.fromOffset(8, 6),
				Size = UDim2.fromOffset(22, 22),
				ZIndex = 10,
			})
			Corner(Tile, 7)

			local Glyph_ = Glyph(Tile, Active and "play" or "library", 14, Active and Color3.fromRGB(30, 215, 96) or Palette.Ink, 11)
			Glyph_.AnchorPoint = Vector2.new(0.5, 0.5)
			Glyph_.Position = UDim2.fromScale(0.5, 0.5)
			Glyph_.Size = UDim2.fromOffset(14, 14)

			New("TextLabel", {
				Parent = Row,
