-- Executor compatibility. Every UNC function this build may reach gets a
-- harmless fallback when the executor does not ship it, so the hub and the
-- bundled WindUI never call a nil. Real functions always win: each slot is
-- only filled when it is still empty. Runs before the hub chunk so both the
-- hub and WindUI see the same globals.
do
    local g = (type(getgenv) == "function" and getgenv()) or _G
    local function put(name, value)
        if g[name] == nil then g[name] = value end
        if rawget(_G, name) == nil then _G[name] = value end
    end
    local function noop() end
    local function identity(value) return value end

    put("getgenv", function() return g end)
    put("getrenv", function() return g end)
    put("getreg", function() return {} end)
    put("getgc", function() return {} end)
    put("cloneref", identity)
    put("clonereference", identity)
    put("compareinstances", function(a, b) return rawequal(a, b) end)
    put("gethui", function()
        local ok, core = pcall(function() return game:GetService("CoreGui") end)
        if ok and core then return core end
        local players = game:GetService("Players")
        return players.LocalPlayer:WaitForChild("PlayerGui")
    end)
    put("protectgui", noop)
    put("protect_gui", noop)
    put("ProtectGui", noop)
    put("getconnections", function() return {} end)
    put("firetouchinterest", noop)
    put("fireproximityprompt", noop)
    put("fireclickdetector", noop)
    put("firesignal", noop)
    put("getcustomasset", function(path)
        local text = tostring(path)
        if text:sub(1, 8) == "rbxasset" then return text end
        return ""
    end)
    put("hookfunction", function(target) return target end)
    put("replaceclosure", function(target) return target end)
    put("restorefunction", noop)
    put("hookmetamethod", function() return noop end)
    put("getrawmetatable", function(value) return getmetatable(value) end)
    put("setreadonly", function() return false end)
    put("isreadonly", function() return true end)
    put("checkcaller", function() return false end)
    put("isexecutorclosure", function() return false end)
    put("newcclosure", identity)
    put("clonefunction", identity)
    put("islclosure", function() return true end)
    put("iscclosure", function() return false end)
    put("is_sirhurt_closure", function() return false end)
    put("queue_on_teleport", noop)
    put("queue_teleport", noop)
    put("identifyexecutor", function() return "unknown", "unknown" end)
    put("getexecutorname", function() return "unknown" end)
    put("getnilinstances", function() return {} end)
    put("getinstances", function() return {} end)
    put("getloadedmodules", function() return {} end)
    put("getrunningscripts", function() return {} end)
    put("getscripts", function() return {} end)
    put("decompile", function() return "" end)
    put("getscriptbytecode", function() return "" end)
    put("getscripthash", function() return "" end)
    put("getfunctionhash", function() return "" end)
    put("setthreadidentity", noop)
    put("set_thread_identity", noop)
    put("getthreadidentity", function() return 8 end)
    put("get_thread_identity", function() return 8 end)
    -- Preserve absence: Main must report unsupported FPS control honestly.
    put("consoleclear", noop)
    put("rconsoleclear", noop)
    put("mousemoverel", noop)
    put("mouse1click", noop)
    put("mouse1press", noop)
    put("mouse1release", noop)
    put("keypress", noop)
    put("keyrelease", noop)
    put("setclipboard", noop)
    put("toclipboard", noop)
    put("setrbxclipboard", noop)

    -- Filesystem: when the executor ships none, keep the files in memory so
    -- configs, key and language still round-trip inside the session. Real
    -- functions always win, so nothing changes on executors that have them.
    do
        local files = {}
        put("writefile", function(path, body)
            files[tostring(path)] = tostring(body)
        end)
        put("appendfile", function(path, body)
            local key = tostring(path)
            files[key] = (files[key] or "") .. tostring(body)
        end)
        put("readfile", function(path)
            local body = files[tostring(path)]
            if body == nil then error("file not found: " .. tostring(path), 2) end
            return body
        end)
        put("isfile", function(path) return files[tostring(path)] ~= nil end)
        put("delfile", function(path) files[tostring(path)] = nil end)
        put("makefolder", noop)
        put("isfolder", function() return true end)
        put("listfiles", function() return {} end)
    end

    -- request(): GET rides game:HttpGet. Anything else reports a failed
    -- status instead of throwing at the call site.
    local function fallbackRequest(options)
        local url = type(options) == "table" and (options.Url or options.url) or tostring(options)
        local method = type(options) == "table" and string.upper(tostring(options.Method or options.method or "GET")) or "GET"
        if method ~= "GET" then
            return { StatusCode = 0, StatusMessage = "unsupported", Success = false, Body = "", Headers = {} }
        end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok then
            return { StatusCode = 0, StatusMessage = tostring(body), Success = false, Body = "", Headers = {} }
        end
        return { StatusCode = 200, StatusMessage = "OK", Success = true, Body = body, Headers = {} }
    end
    put("request", fallbackRequest)
    put("http_request", fallbackRequest)
    put("http", { request = fallbackRequest })
    put("syn", { request = fallbackRequest, protect_gui = noop, queue_on_teleport = noop })

