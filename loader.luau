	self.RenderSources = RenderSources

	--------------------------------------------------------------- pill paint

	-- One owner for pill visibility. Shape only repaints when the capsule
	-- changes size, so every mode edge has to land here instead.
	local function PillStep()
		-- Tool face: the game's mode strip is the only thing on the capsule
		-- while a Build / Paint / Shape / Shovel tool is equipped.
		local Tool = Mode == "tool"
		self.ToolUI.Label.Visible = Tool
		self.ToolUI.Button.Visible = Tool

		-- Music face: a bound provider makes the resting pill a mini player,
		-- track or not. Without one, the idle face is the hub's own mark.
		local Music = Mode == "music" or (Mode == "idle" and State.MusicBound == true)
		local ShowArt = Music and HasTrack
		CoverFrame.Visible = ShowArt
		Wave.Visible = ShowArt and (State.P or 0) < 0.6
		local Mini = ShowArt and not State.Expanded
		IdleUI.MiniTitle.Visible = Mini
		IdleUI.MiniArtist.Visible = Mini

		local Toast = Mode == "toast"
		T.Tile.Visible = Toast
		T.Title.Visible = Toast
		T.Desc.Visible = Toast

		local Loading = Mode == "loading" and not State.Expanded
		LoadTitle.Visible = Loading
		LoadText.Visible = Loading
		LoadPercent.Visible = Loading
		LoadTrack.Visible = Loading

		-- Key mode, collapsed: the pill says what is missing. It steps aside
		-- the moment the card opens.
		local KeyReq = Mode == "key" and not State.Expanded
		KeyReqIcon.Visible = KeyReq
		KeyReqText.Visible = KeyReq

		local Valid = Mode == "valid" or Mode == "loaded"
		ValidIcon.Visible = Valid
		ValidText.Visible = Valid
		if Valid then
			ValidText.Text = Mode == "loaded" and Creator.Translate("SCRIPT_LOADED", "Script Loaded") or Creator.Translate("KEY_VALID", "Key Valid")
		end

		local Idle = Mode == "idle" and not HasTrack
		IdleUI.Icon.Visible = Idle
		IdleUI.Text.Visible = Idle
	end

	local function LoadStep()
		if Mode ~= "loading" then
			return
		end
		local Total = math.max(0.2, LoadDuration)
		local Left = math.max(0, LoadUntil - os.clock())
		local K = math.clamp(1 - Left / Total, 0, 1)
		local Percent = math.floor(K * 100 + 0.5) .. "%"
		if LoadPercent.Text ~= Percent then
			LoadPercent.Text = Percent
		end
		local BarW = math.floor((LOAD_W - 36) * K + 0.5)
		if LoadFill.Size.X.Offset ~= BarW then
			LoadFill.Size = UDim2.fromOffset(BarW, 4)
		end
	end

	--------------------------------------------------------------- public

	-- The island as a general surface: an icon, a title and a line, no music
	-- required. Duration in seconds; the island returns to now-playing on its
	-- own, or immediately through :Dismiss().
	function DynamicIsland:Toast(Options)
		if not self.Alive then
			return
		end
		Options = Options or {}
		local Duration = math.max(0.5, tonumber(Options.Duration) or 3)
		Mode, ToastUntil = "toast", os.clock() + Duration
		self.Mode = Mode
		SetHidden(false)

		if self.Expanded then
			self:Collapse()
		end

		local Source, Rect = Icon(Options.Icon or "note")
		T.Icon.Image = Source
		T.Icon.ImageRectOffset, T.Icon.ImageRectSize = Rect.ImageRectPosition, Rect.ImageRectSize
		T.Icon.ImageColor3 = Options.Color or Palette.Ink
		T.Title.Text = tostring(Options.Title or Options.Text or "")
		T.Title.TextColor3 = Options.Color or Palette.Ink
		local Description = tostring(Options.Description or Options.Desc or "")
		T.Desc.Text = Description
		T.Title.Position = UDim2.fromOffset(64, Description ~= "" and 16 or 27)
		PillStep()

		if self.Config.OnToast then
			pcall(self.Config.OnToast, self, Options)
		end
	end

	function DynamicIsland:Dismiss()
		if Mode ~= "toast" then
			return
		end
		Mode, ToastUntil = "idle", 0
		self.Mode = Mode
		if Config.HideWhenDone then
			SetHidden(true)
		end
		T.Icon.ImageColor3 = Palette.Ink
		T.Title.TextColor3 = Palette.Ink
		PillStep()
	end

	-- The resting face. A hub passes its own mark and name so the capsule reads
	-- as the open button rather than a music widget with nothing to play.
	function DynamicIsland:SetIdle(Icon_, Text_)
		if not self.Alive then
			return
		end
		if type(Icon_) == "string" and Icon_ ~= "" then
			IdleUI.Icon.Image = Icon_
			IdleUI.Icon.ImageRectOffset = Vector2.zero
			IdleUI.Icon.ImageRectSize = Vector2.zero
			IdleUI.Icon.ImageColor3 = Palette.Ink
		end
		if type(Text_) == "string" and Text_ ~= "" then
			IdleUI.Text.Text = Text_
		end
		if self.Expanded then
			self:Collapse()
		end
		Mode, ToastUntil, LoadedUntil = "idle", 0, 0
		self.Mode = Mode
		PillStep()
	end

	-- Tool strip. The game owns the mode state: every tap is forwarded to the
	-- game's own Button.Activated, and the text and colours come back through
	-- the mirror. The island never guesses a mode.
	function DynamicIsland:SetTool(Options)
		if not self.Alive then
			return
		end
		Options = Options or {}
		if self.Expanded then
			self:Collapse()
		end
		Mode, ToastUntil, LoadedUntil = "tool", 0, 0
		self.Mode = Mode
		self.ToolClick = type(Options.OnClick) == "function" and Options.OnClick or nil
		self.ToolUI.Label.Text = tostring(Options.Label or "")
		self.ToolUI.Button.Text = tostring(Options.Button or "")
		if typeof(Options.LabelColor) == "Color3" then
			self.ToolUI.Label.TextColor3 = Options.LabelColor
		end
		if typeof(Options.TextColor) == "Color3" then
			self.ToolUI.Button.TextColor3 = Options.TextColor
			self.ToolUI.Icon.ImageColor3 = Options.TextColor
			self.ToolUI.Stroke.Color = Options.TextColor
		end
		if type(Options.Icon) == "string" then
			PaintToolIcon(self.ToolUI.Icon, Options.Icon)
		end
		SetHidden(false)
		PillStep()
	end

	function DynamicIsland:ClearTool()
		if not self.Alive or Mode ~= "tool" then
			return
		end
		Mode, ToastUntil = "idle", 0
		self.Mode = Mode
		self.ToolClick = nil
		PillStep()
	end

	-- The outline is a glass rim for a floating widget. A hub that uses the
	-- capsule as its open button wants the flat island look instead.
	function DynamicIsland:SetOutline(Value)
		if self.Outline then
			self.Outline.Visible = Value ~= false
		end
	end

	-- Called when the capsule is tapped with no card to open: the hub uses it to
	-- restore a window that folded into the pill.
	function DynamicIsland:SetOnTap(Callback)
		self.OnTap = type(Callback) == "function" and Callback or nil
	end

	-- One spring out and back, no state change. Fired when a window lands.
	function DynamicIsland:Ping()
		State.PingUntil = os.clock() + 0.32
	end

	-- Music is opt-in. Binding swaps the idle face for the mini player and
	-- starts the provider poll; unbinding puts the hub mark back.
	function DynamicIsland:BindMusic(Providers, Folder)
		if not self.Alive or self.MusicBound then
			return
		end
		local List = Providers
		if type(List) ~= "table" or #List == 0 then
			List = { "files", "demo" }
		end
		self.MusicBound = true
		Surface.Bind(self, {
			Providers = List,
			Folder = Folder or Config.Folder or "Ender Hub/songs",
			WindUI = self.WindUI,
		})
		PillStep()
	end

	function DynamicIsland:UnbindMusic()
		if not self.Alive or not self.MusicBound then
			return
		end
		self.MusicBound = false
		if self.Expanded then
			self:Collapse()
		end
		Surface.Release(self)
		self.Sources, self.SourceIndex, self.Provider, self.MusicState = {}, 1, nil, nil
		Title, Artist, Cover, Hint = "", "", "", ""
		Playing = false
		HasTrack = false
		Sleeve.Given = nil
		WaveTune.Art, WaveTune.ArtRect, WaveTune.Shade = nil, Vector2.zero, nil
		WaveTune.PushedKey = nil
		local Window = self.WindUI and self.WindUI.Window
		if Window and type(Window.SetMusicState) == "function" then
			pcall(Window.SetMusicState, Window, false, "", Vector2.zero, nil)
		end
		if self.Bars then
			for _, Bar in ipairs(self.Bars) do
				if Bar.Frame then
					Bar.Frame.Image = ""
					Bar.Frame.ImageRectOffset = Vector2.zero
					Bar.Frame.BackgroundColor3 = Palette.Ink
					Bar.Frame.BackgroundTransparency = 0
					Bar.Frame.ImageTransparency = 1
					if Bar.Grad then
						Bar.Grad.Color = ColorSequence.new(Palette.Ink, Palette.Ink)
					end
				end
			end
		end
		State.CoverColor = nil
		self.CoverColor = nil
		TitleLabel.Text = Creator.Translate("NOTHING_PLAYING", "Nothing playing")
		ArtistLabel.Text = ""
		CoverFrame.Image = ""
		CoverFrame.BackgroundTransparency = 0
		Mark.Visible = true
		CoverGrad.Enabled = true
		if self.MiniTitle then
			self.MiniTitle.Text = Creator.Translate("NOTHING_PLAYING", "Nothing playing")
			self.MiniArtist.Text = ""
		end
		PillStep()
	end

	-- Loading: the card-sized state. Hub name, what is loading, the percent,
	-- and a bar along the bottom. The island flips itself to the key prompt
	-- when the timer runs out.
	function DynamicIsland:Loading(Duration, Label_)
		if not self.Alive then
			return
		end
		if self.Expanded then
			self:Collapse()
		end
		SetHidden(false)
		LoadDuration = math.max(0.2, tonumber(Duration) or 5)
		LoadUntil = os.clock() + LoadDuration
		LoadTitle.Text = tostring((type(KeyCfg) == "table" and KeyCfg.LoadingTitle) or Creator.Translate("ENDER_HUB", "Ender Hub"))
		LoadText.Text = tostring(Label_ or (type(KeyCfg) == "table" and KeyCfg.Loading) or "Loading modules, ui...")
		LoadPercent.Text = "0%"
		LoadFill.Size = UDim2.fromOffset(0, 4)
		Mode = "loading"
		self.Mode = Mode
		PillStep()
	end

	function DynamicIsland:SetProgress(Value)
		if Mode ~= "loading" then
			return
		end
		local K = math.clamp(tonumber(Value) or 0, 0, 1)
		LoadUntil = os.clock() + (1 - K) * math.max(0.2, LoadDuration)
		LoadPercent.Text = math.floor(K * 100 + 0.5) .. "%"
		LoadFill.Size = UDim2.fromOffset(math.floor((LOAD_W - 36) * K + 0.5), 4)
	end

	-- Stage line without restarting the bar. Loading() would zero the fill, so
	-- every later stage goes through here instead.
	function DynamicIsland:SetLoadingLabel(Text)
		if Mode ~= "loading" then
			return
		end
		LoadText.Text = tostring(Text or "")
	end

	-- Key prompt: the card at the content origin. Expanding is the show, so
	-- the ordinary island toggle hides and re-shows it with no extra state.
	function DynamicIsland:ShowKey()
		if not self.Alive or type(KeyCfg) ~= "table" then
			return
		end
		Mode = "key"
		self.Mode = Mode
		SetHidden(false)
		SetKeyError("")
		KeyShakeUntil = 0
		K.Row.Position = UDim2.fromOffset(KeyPad, 58)
		K.Note.Text = tostring(KeyCfg.Note or "Enter your key to unlock the interface.")
		K.Title.Text = tostring(KeyCfg.Title or Creator.Translate("KEY_SYSTEM", "Key System"))
		K.Input.PlaceholderText = tostring(KeyCfg.Placeholder or "Enter Your Key")
		K.Input.Text = ""
		PillStep()
		self:Expand()
	end

	function DynamicIsland:HideKey()
		if Mode ~= "key" then
			return
		end
		if self.Expanded then
			self:Collapse()
		end
	end

	function DynamicIsland:KeyValid()
		if not self.Alive then
			return
		end
		Mode = "valid"
		self.Mode = Mode
		KeyGiven = true
		local ValidFor = type(KeyCfg) == "table" and tonumber(KeyCfg.ValidFor) or nil
		ValidUntil = os.clock() + (ValidFor or 4)
		if self.Expanded then
			self:Collapse()
		end
		SetKeyError("")
		K.Input.Text = ""
		PillStep()
		if type(KeyCfg) == "table" and KeyCfg.Callback then
			pcall(KeyCfg.Callback, true)
		end
		if self.Config.OnKeyValid then
			pcall(self.Config.OnKeyValid, self)
		end
	end

	function DynamicIsland:DismissKey()
		if Mode ~= "valid" then
			return
		end
		Mode = "idle"
		self.Mode = Mode
		if Config.HideWhenDone then
			SetHidden(true)
		end
		PillStep()
	end

	function DynamicIsland:Expand()
		if self.Expanded or not self.Alive or Mode == "toast" or Mode == "tool" then
			return
		end
		self.Expanded = true
		LeftAt = nil
		Expand.goal, Expand.at = 1, os.clock()
		PillStep()
		PaintState()
		PaintPlay()
		if self.Config.OnExpand then
			pcall(self.Config.OnExpand, self)
		end
	end

	function DynamicIsland:Collapse()
		if not self.Expanded or not self.Alive then
			return
		end
		self.Expanded = false
		self.SideOpen = false
		Expand.goal, Expand.at = 0, os.clock()
		PillStep()
		if self.Config.OnCollapse then
			pcall(self.Config.OnCollapse, self)
		end
	end

	function DynamicIsland:Toggle()
		if self.Expanded then
			self:Collapse()
		else
			self:Expand()
		end
	end

	function DynamicIsland:ToggleSide(Force)
		if Force ~= nil then
			self.SideOpen = Force == true
		else
			self.SideOpen = not self.SideOpen
		end
		if self.SideOpen and not self.Expanded then
			self:Expand()
		end
	end

	function DynamicIsland:ToggleShuffle()
		self.Shuffled = not self.Shuffled
		local Provider = self.Provider
		if Provider then
			if type(Provider.Shuffle) == "function" then
				pcall(Provider.Shuffle, Provider, self.Shuffled)
			else
				Provider.Shuffle = self.Shuffled
			end
		end
		local Record = self.ChipBy.shuffle
		if Record then
			Record.On = self.Shuffled
		end
		PaintState()
	end

	function DynamicIsland:SelectSource(Index, Silent)
		Surface.SelectSource(self, Index, Silent)
	end

	function DynamicIsland:SetSource(Source)
		Surface.SetSource(self, Source)
	end

	function DynamicIsland:CycleSource()
		local Next_ = (self.SourceIndex % math.max(#self.Sources, 1)) + 1
		self:SelectSource(Next_)
	end

	function DynamicIsland:TogglePlay()
		local Provider = self.Provider
		if not Provider then
			return
		end
		if Playing then
			Provider:Pause(function() end)
		else
			Provider:Play(function() end)
		end
	end

	function DynamicIsland:Play()
		if self.Provider then
			self.Provider:Play(function() end)
		end
	end

	function DynamicIsland:Pause()
		if self.Provider then
			self.Provider:Pause(function() end)
		end
	end

	function DynamicIsland:Next()
		if self.Provider then
			self.Provider:Next(function() end)
		end
	end

	function DynamicIsland:Previous()
		if self.Provider then
			self.Provider:Previous(function() end)
		end
	end

	function DynamicIsland:Seek(Seconds)
		if self.Provider and self.Provider.Seek then
			self.Provider:Seek(Seconds, function() end)
		end
	end

	function DynamicIsland:SetVolume(Percent)
		if self.Provider and self.Provider.SetVolume then
			self.Provider:SetVolume(math.clamp(Percent or 60, 0, 100), function() end)
		end
	end

	function DynamicIsland:GetState()
		return self.MusicState
	end

	function DynamicIsland:Show()
		SetHidden(false)
	end

	-- Sticky: the frame loop re-shows the root every step, so a plain
	-- Root.Visible = false would come straight back.
	function DynamicIsland:Hide()
		SetHidden(true)
	end

	function DynamicIsland:RenderState(State_)
		self.MusicState = State_

		Title = State_.Title ~= "" and State_.Title or (State_.Hint or Creator.Translate("NOTHING_PLAYING", "Nothing playing"))
		Artist = State_.Artist or ""
		Hint = State_.Hint or ""
		Playing = State_.Playing == true
		Duration = tonumber(State_.Duration) or 0
		Position = tonumber(State_.Position) or 0
		PositionAt = os.clock()

		if TitleLabel.Text ~= Title then
			TitleLabel.Text = Title
		end
		if ArtistLabel.Text ~= Artist then
			ArtistLabel.Text = Artist
		end
		if self.MiniTitle then
			self.MiniTitle.Text = Title
			self.MiniArtist.Text = Artist ~= "" and Artist or Hint
		end

		ArtW = tonumber(State_.CoverW) or 0
		ArtH = tonumber(State_.CoverH) or 0

		local Track = State_.Title ~= nil and tostring(State_.Title) ~= ""
		if Track ~= HasTrack then
			HasTrack = Track
			PillStep()
		end

		local NewCover = State_.Cover or ""
		if Cover ~= NewCover then
			Cover = NewCover
			if Cover ~= "" then
				CoverFrame.Image = Cover
				Mark.Visible = false
				CoverGrad.Enabled = false
				CoverFrame.BackgroundTransparency = 1
			else
				CoverFrame.Image = ""
				Mark.Visible = true
				CoverGrad.Enabled = true
				CoverFrame.BackgroundTransparency = 0
			end
		end

		Sleeve.Given = Sleeve.Parse(State_.Tint or State_.Accent)

		PaintPlay()
		PaintState()
	end

	function DynamicIsland:RenderError(Message)
		Hint = tostring(Message or "Unavailable")
		if ArtistLabel then
			ArtistLabel.Text = Hint
		end
		if self.MiniArtist then
			self.MiniArtist.Text = Hint
		end
	end

	function DynamicIsland:Destroy()
		if not self.Alive then
			return
		end
		self.Alive = false

		for _, Signal in ipairs(self.Signals) do
			pcall(function()
				Signal:Disconnect()
			end)
		end
		self.Signals = {}

		Surface.Release(self)

		if self.Host then
			self.Host:Destroy()
			self.Host = nil
		end
		self.Root = nil
	end

	--------------------------------------------------------------- input

	Hit.Activated:Connect(function()
		Pressing, Peeking = false, false
		if Mode == "toast" then
			State:Dismiss()
		elseif Mode == "idle" then
			-- No card to open: the hub owns the tap. Music, when bound, still
			-- opens the player through the same hook.
			if State.OnTap then
				pcall(State.OnTap, State)
			end
			return
		elseif Mode == "loading" then
			return
		elseif Mode == "valid" then
			State:DismissKey()
		elseif State.Expanded then
			State:Collapse()
		else
			State:Expand()
		end
	end)

	Hit.InputBegan:Connect(function(Input)
		local Type_ = Input.UserInputType
		if Type_ == Enum.UserInputType.MouseButton2 or Type_ == Enum.UserInputType.MouseButton3 then
			if Mode ~= "idle" then
				State:Expand()
			end
		end
		if (Type_ == Enum.UserInputType.MouseButton1 or Type_ == Enum.UserInputType.Touch) and not State.Expanded then
			Pressing = true
		end
	end)

	Hit.MouseLeave:Connect(function()
		Pressing = false
	end)

	local function RelAt(X)
		return math.clamp((X - Track.AbsolutePosition.X) / math.max(1, Track.AbsoluteSize.X), 0, 1)
	end

	local function SeekTo(Rel)
		local Provider = State.Provider
		if Provider and Provider.Seek and Duration > 0 then
			pcall(Provider.Seek, Provider, Rel * Duration)
		end
		Position, PositionAt = Rel * Duration, os.clock()
	end

	SeekHit.InputBegan:Connect(function(Input)
		local Type_ = Input.UserInputType
		if Type_ == Enum.UserInputType.MouseButton1 or Type_ == Enum.UserInputType.Touch then
			ScrubDrag = true
			ScrubRel = RelAt(Input.Position.X)
		end
	end)

	table.insert(self.Signals, UserInputService.InputBegan:Connect(function(Input)
		local Type_ = Input.UserInputType
		if (Type_ == Enum.UserInputType.MouseButton1 or Type_ == Enum.UserInputType.Touch or Type_ == Enum.UserInputType.MouseWheel)
			and State.Expanded
			and PointerOver(28)
		then
			TouchAt = os.clock()
		end
	end))

	table.insert(self.Signals, UserInputService.InputChanged:Connect(function(Input)
		local Type_ = Input.UserInputType
		if Type_ == Enum.UserInputType.MouseWheel and State.Expanded and PointerOver(28) then
			TouchAt = os.clock()
		end
		local Moving = Type_ == Enum.UserInputType.MouseMovement or Type_ == Enum.UserInputType.Touch
		if ScrubDrag and Moving then
			ScrubRel = RelAt(Input.Position.X)
		end
		if GlassHeld and Moving then
			GlassHeld.Raw = Vector2.new(Input.Position.X, Input.Position.Y) - GlassHeld.Start
		end
	end))

	table.insert(self.Signals, UserInputService.InputEnded:Connect(function(Input)
		local Type_ = Input.UserInputType
		local Up = Type_ == Enum.UserInputType.MouseButton1 or Type_ == Enum.UserInputType.Touch
		if Up then
			Pressing = false
		end
		if ScrubDrag and Up then
			SeekTo(ScrubRel)
			ScrubDrag = false
		end
		local Record = GlassHeld
		if Record and Up then
			GlassHeld = nil
			Record.Hold = false
			local Distance = Record.Raw.Magnitude
			if Record.Callback and ((Record.Touch and Distance < 36) or (not Record.Touch and Record.Over and Distance < 60)) then
				pcall(Record.Callback)
			end
		end
	end))

	--------------------------------------------------------------- loop

	local function Hover(Now)
		local Open = State.Expanded
		if PointerOver(Open and 28 or 0) then
			LeftAt = nil
			Touched = true
			Peeking = not Open
		else
			Peeking = false
			if Open and Touched and not ScrubDrag and not GlassHeld and Mode ~= "key" and State.Config.AutoCollapse ~= false then
				local Busy = Now - (TouchAt or -9) < 1.2
					or Now - Expand.at < 0.6
					or math.abs(Width.v) > 40
					or math.abs(Height.v) > 40
				if Busy or not LeftAt then
					LeftAt = Now
				end
				if Now - LeftAt > 1 then
					State:Collapse()
				end
			end
		end
	end

	local function FrameStep(Delta)
		local Now = os.clock()

		if Mode == "toast" and Now >= ToastUntil then
			State:Dismiss()
		elseif Mode == "loading" and Now >= LoadUntil then
			-- Key first, when the hub is gated: the prompt replaces the pill the
			-- moment the bar fills, with no "loaded" claim before the key lands.
			if type(KeyCfg) == "table" and not KeyGiven then
				State:ShowKey()
			else
				Mode, LoadedUntil = "loaded", Now + (type(KeyCfg) == "table" and (tonumber(KeyCfg.LoadedFor) or 3) or 3)
				State.Mode = Mode
				PillStep()
			end
		elseif Mode == "loaded" and Now >= LoadedUntil then
			if Config.HideWhenDone then
				SetHidden(true)
			elseif type(KeyCfg) == "table" then
				State:ShowKey()
			else
				Mode = "idle"
				State.Mode = Mode
				PillStep()
			end
		elseif Mode == "valid" and Now >= ValidUntil then
			State:DismissKey()
		end

		if not Hidden and not Root.Visible then
			Root.Visible = true
		end

		BeatAcc += Delta
		if BeatAcc >= 0.12 then
			BeatAcc = 0
			BeatTarget = math.random()
		end
		Beat = Fade(Beat, BeatTarget, 6, Delta)

		Hover(Now)
		Shape(Delta)

		-- Shape only repaints when the capsule changes size, so the swap
		-- between artwork, toast, loading and valid happens on the mode edge.
		if PillMode ~= Mode then
			PillMode = Mode
			PillStep()
		end

		LoadStep()

		FadeStep(Delta, Now)

		if Expand.a > 0 then
			ProgressStep(Delta)
			PaintPlay()
			GlassStep(Delta)
			SideStep(Delta)
			LayoutStep()
			if KeyShakeUntil > 0 then
				local Left = KeyShakeUntil - Now
				if Left <= 0 then
					KeyShakeUntil = 0
					K.Row.Position = UDim2.fromOffset(KeyPad, 58)
				else
					local T = 1 - Left / 0.45
					local Offset = math.sin(T * math.pi * 9) * 7 * (1 - T)
					K.Row.Position = UDim2.fromOffset(math.floor(KeyPad + Offset + 0.5), 58)
				end
			end
			ChipStateStep()
			ChipStep(Delta)
			TopStep(Delta, Root.Size.X.Offset)
			StatusStep(Now)
			TintStep()
		end

		-- The pill's bars animate while collapsed too, so they run outside the
		-- expand gate the way the reference does.
		WaveStep(Delta)
	end

	local Connection = RunService.RenderStepped:Connect(function(Delta)
		if not State.Alive then
			return
		end
		local Ok, Err = pcall(FrameStep, Delta)
		if Ok then
			pcall(FX.Step)
		else
			warn("WindUI dynamic island: " .. tostring(Err))
		end
	end)
	self.Connection = Connection

	--------------------------------------------------------------- boot

	Root.Visible = true
	Expand.a, Expand.goal, Expand.at = 0, 0, os.clock()

	for _, Descendant in ipairs(Root:GetDescendants()) do
		FX.Claim(Descendant)
	end
	table.insert(self.Signals, Root.DescendantAdded:Connect(FX.Claim))

	-- Music is opt-in: an island created without a provider list is a pure
	-- surface (loading, key, toast, idle). No demo folder scan runs behind it.
	if type(Config.Providers) == "table" and #Config.Providers > 0 then
		self.MusicBound = true
		Surface.Bind(self, Config)
	end
	PaintState()
	PaintPlay()

	if Config.Expanded then
		self.Expanded = false
		self:Expand()
	end

	-- Key system: the island owns the flow now. Loading pill for Delay
	-- seconds, then the key card; a saved key skips straight to the tick.
	if type(KeyCfg) == "table" then
		local Saved = KeyCfg.SavedKey
		if Saved ~= nil and ValidKey(tostring(Saved)) then
			self:KeyValid()
		else
			self:Loading(KeyCfg.Delay or 5, KeyCfg.Loading or "Loading")
		end
	end

	return self
end

return DynamicIsland
end

__modules["src/modules/MusicSurface.lua"] = function(require)
-- MusicSurface - the provider plumbing both music elements share.
--
--   MusicSurface.Bind(self, Config)
--
-- Gives `self` the source list, the poll loop and the transport methods, and
-- calls `self:RenderState(State)` whenever a provider hands back a track.
-- `Config.Providers` is an array of entries: "files", "spotify", "demo",
-- "sound", or a bridge table. `Config.Folder` is the folder the files
-- provider reads.

local Providers = require("src/modules/MusicProviders.lua")

local Surface = {}

-- Elements that ask for the same sources share one provider set, so the island
-- and the mini player drive the same Sound: play in one, pause in the other.
local Shared = {}

local function ShareKey(Config)
	if Config.Share ~= nil then
		return tostring(Config.Share)
	end
	local Parts = {}
	for _, Entry in ipairs(Config.Providers or {}) do
		Parts[#Parts + 1] = type(Entry) == "table" and tostring(Entry.Id or Entry.Name or Entry.Url) or tostring(Entry)
	end
	return "auto|" .. (Config.Folder or "Ender Hub/songs") .. "|" .. table.concat(Parts, ",")
end

local function CreateProvider(Entry, Config)
	if type(Entry) == "table" then
		return Providers.NewBridge(Entry)
	end
	if Entry == "files" then
		return Providers.NewFolder({ Path = Config.Folder or "Ender Hub/songs" })
	end
	if Entry == "spotify" then
		return Providers.NewSpotify(Config.Spotify or {})
	end
	if Entry == "demo" then
		return Providers.NewDemo()
	end
	if Entry == "sound" then
		return Providers.NewSound({ Sound = Config.Sound })
	end
	return nil
end

function Surface.Bind(Object, Config)
	local Key = ShareKey(Config)
	local Record = Shared[Key]

	if not Record then
		Record = { Sources = {}, Index = 1, Refs = 0, Connected = false, Objects = {} }
		local Entries = Config.Providers or { "files", "spotify", "demo" }
		if type(Entries) ~= "table" then
			Entries = { Entries }
		end
		for _, Entry in ipairs(Entries) do
			local Provider = CreateProvider(Entry, Config)
			if Provider then
				table.insert(Record.Sources, Provider)
			end
		end
		if #Record.Sources == 0 then
			table.insert(Record.Sources, Providers.NewDemo())
		end
		Shared[Key] = Record
	end

	Record.Refs += 1
	table.insert(Record.Objects, Object)

	Object.Share = Record
	Object.Sources = Record.Sources
	Object.SourceIndex = Record.Index
	Object.Provider = Record.Sources[Record.Index]
	Object.MusicState = nil

	local Provider = Object.Provider
	if Provider then
		if not Record.Connected then
			Record.Connected = true
			if Provider.Connect then
				Provider:Connect({}, function() end)
			end
		end
		if Object.RenderSources then
			Object:RenderSources()
		end
	end

	task.spawn(function()
		while Object.Alive and Object.MusicBound ~= false do
			local Active = Object.Provider
			if Active and Active.Poll then
				local Ok = pcall(function()
					Active:Poll(function(Success, State)
						if not Object.Alive or Object.Provider ~= Active then
							return
						end
						if Success and type(State) == "table" then
							Object.MusicState = State
							if Object.RenderState then
								Object:RenderState(State)
							end
						elseif Object.RenderError then
							Object:RenderError(tostring(State or "Unavailable"))
						end
					end)
				end)
				if not Ok and Object.RenderError then
					Object:RenderError("Poll error")
				end
			end
			task.wait(Config.PollRate or 0.25)
		end
	end)
end

function Surface.SelectSource(Object, Index, Silent)
	local Provider = Object.Sources[Index]
	if not Provider then
		return
	end

	Object.SourceIndex = Index
	Object.Provider = Provider

	local Record = Object.Share
	if Record then
		Record.Index = Index
		for _, Other in ipairs(Record.Objects) do
			if Other ~= Object and Other.Alive then
				Other.SourceIndex = Index
				Other.Provider = Provider
				if Other.RenderSources then
					Other:RenderSources()
				end
			end
		end
	end

	if not Silent and Provider.Connect then
		Provider:Connect({}, function(Ok, Message)
			if not Object.Alive then
				return
			end
			if not Ok and Object.RenderError then
				Object:RenderError(tostring(Message or "Unavailable"))
			end
		end)
	end

	if Object.RenderSources then
		Object:RenderSources()
	end
end

function Surface.SetSource(Object, Source)
	if type(Source) == "number" then
		Surface.SelectSource(Object, Source)
		return
	end
	for Index, Provider in ipairs(Object.Sources) do
		if Provider.Id == Source or Provider.Name == Source then
			Surface.SelectSource(Object, Index)
			return
		end
	end
end

function Surface.Release(Object)
	local Record = Object.Share
	if Record then
		Record.Refs = math.max(0, Record.Refs - 1)
		for Index, Other in ipairs(Record.Objects) do
			if Other == Object then
				table.remove(Record.Objects, Index)
				break
			end
		end
		Object.Share = nil
		if Record.Refs > 0 then
			return
		end
		for Key, Entry in pairs(Shared) do
			if Entry == Record then
				Shared[Key] = nil
			end
		end
	end

	for _, Provider in ipairs(Object.Sources or {}) do
		pcall(function()
			Provider:Disconnect()
		end)
	end
end

Surface.FormatTime = Providers.FormatTime

return Surface
end

__modules["src/modules/MusicProviders.lua"] = function(require)
-- Transport layer for the Music widget.
--
-- One contract, five transports. The UI never learns which service is on the
-- other end:
--
--   Provider.Id        string          "spotify" | "files" | "sound" | "bridge" | "demo"
--   Provider.Name      string
--   Provider.Kind      "remote" | "files" | "sound" | "bridge" | "demo"
--   Provider.Connected boolean
--   Provider.Account   string?
--   Provider.Status    string          one line, rendered verbatim
--
--   Provider:Connect(options, done)    done(ok, message)
--   Provider:Poll(done)                done(ok, state | message)
--   Provider:Play(done)  :Pause(done)  :Next(done)  :Previous(done)
--   Provider:Seek(seconds, done)
--   Provider:SetVolume(percent, done)  0-100
--   Provider:Disconnect()
--
-- state = {
--     Title, Artist, Album, Cover,
--     Position, Duration, Playing, Volume,
--     CanSeek, CanSkip, Link,
-- }
--
-- Spotify talks to the Web API directly from the executor. Auth is PKCE with a
-- pasted redirect URL (the widget owns the form); nothing here opens a browser.
-- Local files are listed from a folder and played through a Sound whose SoundId
-- points at rbxasset://, which is how executors expose a file on disk.

local cloneref = (cloneref or clonereference or function(instance)
	return instance
end)

local HttpService = cloneref(game:GetService("HttpService"))
local SoundService = cloneref(game:GetService("SoundService"))

local Creator = require("src/modules/Creator.lua")
local CoverSize = require("src/modules/CoverSize.lua")

local Providers = {}

------------------------------------------------------------------ encoding

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

-- Spotify's token endpoint speaks form encoding and PKCE needs base64url, so
-- the encoder lives here rather than in a dependency.
local function Base64(Input)
	local Output = {}
	Input = tostring(Input)

	for Index = 1, #Input, 3 do
		local First, Second, Third = Input:byte(Index, Index + 2)
		local Value = First * 65536 + (Second or 0) * 256 + (Third or 0)

		local A = math.floor(Value / 262144) % 64
		local B = math.floor(Value / 4096) % 64
		local C = math.floor(Value / 64) % 64
		local D = Value % 64

		Output[#Output + 1] = B64:sub(A + 1, A + 1) .. B64:sub(B + 1, B + 1)
		Output[#Output + 1] = Second and B64:sub(C + 1, C + 1) or "="
		Output[#Output + 1] = Third and B64:sub(D + 1, D + 1) or "="
	end

	return table.concat(Output)
end

local function Base64Url(Input)
	return (Base64(Input):gsub("%+", "-"):gsub("/", "_"):gsub("=", ""))
end

local function UrlEncode(Value)
	return (
		tostring(Value):gsub("[^%w%-%._~]", function(Character)
			return string.format("%%%02X", string.byte(Character))
		end)
	)
end

--------------------------------------------------------------- sha-256 core

local K = {
	0x428a2f98,
	0x71374491,
	0xb5c0fbcf,
	0xe9b5dba5,
	0x3956c25b,
	0x59f111f1,
	0x923f82a4,
	0xab1c5ed5,
	0xd807aa98,
	0x12835b01,
	0x243185be,
	0x550c7dc3,
	0x72be5d74,
	0x80deb1fe,
	0x9bdc06a7,
	0xc19bf174,
	0xe49b69c1,
	0xefbe4786,
	0x0fc19dc6,
	0x240ca1cc,
	0x2de92c6f,
	0x4a7484aa,
	0x5cb0a9dc,
	0x76f988da,
	0x983e5152,
	0xa831c66d,
	0xb00327c8,
	0xbf597fc7,
	0xc6e00bf3,
	0xd5a79147,
	0x06ca6351,
	0x14292967,
	0x27b70a85,
	0x2e1b2138,
	0x4d2c6dfc,
	0x53380d13,
	0x650a7354,
	0x766a0abb,
	0x81c2c92e,
	0x92722c85,
	0xa2bfe8a1,
	0xa81a664b,
	0xc24b8b70,
	0xc76c51a3,
	0xd192e819,
	0xd6990624,
	0xf40e3585,
	0x106aa070,
	0x19a4c116,
	0x1e376c08,
	0x2748774c,
	0x34b0bcb5,
	0x391c0cb3,
	0x4ed8aa4a,
	0x5b9cca4f,
	0x682e6ff3,
	0x748f82ee,
	0x78a5636f,
	0x84c87814,
	0x8cc70208,
	0x90befffa,
	0xa4506ceb,
	0xbef9a3f7,
	0xc67178f2,
