        local players = game:GetService("Players")
        return players.LocalPlayer:WaitForChild("PlayerGui")
    end)
    put("protectgui", noop)
    put("protect_gui", noop)
    put("ProtectGui", noop)
    put("getconnections", function() return {} end)
    put("firetouchinterest", noop)
    put("fireproximityprompt", noop)
    put("fireclickdetector", noop)
    put("firesignal", noop)
    put("getcustomasset", function(path)
