    local trace = type(debug) == "table" and type(debug.traceback) == "function" and debug.traceback(text, 2) or text
    return trace
end)
if not __ok then
    __g.EnderHubBootError = __err
    local misses = type(__g.EnderHubBootMisses) == "table" and __g.EnderHubBootMisses or {}
    local tail = {}
    for index = math.max(1, #misses - 11), #misses do
        tail[#tail + 1] = tostring(misses[index])
    end
    local seen = "[Ender Hub] boot failed at stage " .. tostring(__g.EnderHubBootStage) .. ": " .. tostring(__err)
    if #tail > 0 then
        seen = seen .. " | missing globals: " .. table.concat(tail, ", ")
    end
    warn(seen)
    pcall(function()
        if type(writefile) == "function" then writefile("EnderHubBoot.txt", seen) end
    end)
end
return __ok
end)(...))