				Dot.AnchorPoint = Vector2.new(1, 0.5)
				Dot.Position = UDim2.new(1, -12, 0.5, 0)
				Dot.Size = UDim2.fromOffset(14, 14)
			end

			Row.Activated:Connect(function()
				KeepUntil = os.clock() + 4
