__modules["src/components/PlayerTags.lua"] = function(require)
--[[
    Overhead player tags.

    A BillboardGui above the head of every player that has a rank in
    Config.Ranks. Layout, matching the Dynamic Island:

        (icon) Ender Hub                    (age) 3y  (clock) 7436
                       Rank
                    @DisplayName

    The brand sits in the top-left, the rank is the loudest centred line, the
    handle is the subtle description under it, and the status row in the
    top-right mirrors the island's icon + value pairing: account age and the
    player's leaderboard time. Both are replicated, so they read correctly on
    someone else's tag.
    The tag has a solid rounded background with the island's shadow stack,
    colours follow the active WindUI theme unless Config.Colors pins them,
    and it re-attaches on respawn so a dead owner keeps the label over the
    body until the character is replaced.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Creator = require("src/modules/Creator.lua")
local New = Creator.New

local PlayerTags = {}
PlayerTags.__index = PlayerTags

local DEFAULT_TEXT = Color3.new(1, 1, 1)
local DEFAULT_SUBTLE = Color3.fromRGB(154, 156, 164)
local DEFAULT_ACCENT = Color3.fromRGB(110, 220, 170)
local DEFAULT_BACKGROUND = Color3.fromRGB(16, 16, 18)
local DEFAULT_ICON = "rbxassetid://84919257334887"

-- Same corner and shadow stack as the Dynamic Island: 20 px radius when the
-- island is collapsed, a 38 px dark glow and a tight contact shadow.
local DEFAULT_CORNER = 20

-- Tags fade out past this many studs, and shrink as the player walks away so a
-- crowded server does not turn into a wall of billboards. Both are ceilings the
-- Config can raise; the defaults match the hub's own spec.
local DEFAULT_MAX_DISTANCE = 1000
local DEFAULT_NEAR_DISTANCE = 40
local DEFAULT_MIN_SCALE = 0.45

-- AccountAge is replicated for every player, so the age chip reads correctly
-- on someone else's tag. One unit, no label: 3y, 7mo, 12d.
local function AgeText(days)
	days = math.max(0, math.floor(tonumber(days) or 0))
	if days >= 365 then
		return (days // 365) .. "y"
	end
	if days >= 30 then
		return (days // 30) .. "mo"
	end
	return days .. "d"
end

-- Theme values may be gradients; TextColor3 cannot take one, so the first
-- keypoint is the readable stand-in.
local function colorOf(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "table" and value.Color then
		local points = value.Color.Keypoints
		if points and points[1] then
			return points[1].Value
		end
	end
	return fallback
end

local function normalizeMap(map)
	local out = {}
	for key, value in pairs(map or {}) do
		out[string.lower(tostring(key))] = value
	end
	return out
end

function PlayerTags.New(Config, WindUI)
	local self = setmetatable({
		Config = Config or {},
		WindUI = WindUI,
		Tags = {},
		PlayerConns = {},
		StatConns = {},
		Alive = true,
		-- Clicking a tag is opt-in from the hub, on by default here so the fork
		-- behaves the same whether or not the caller knows about the flag.
		Clickable = (Config or {}).Clickable ~= false,
		LocalPlayer = Players.LocalPlayer,
	}, PlayerTags)

	self.Ranks = normalizeMap(self.Config.Ranks)
	self.RankColors = normalizeMap(self.Config.RankColors)
	self.Colors = {}
	self:ResolveColors()

	self:Scan()
	self:StartScaleLoop()
	self.PlayerAddedConn = Players.PlayerAdded:Connect(function(player)
		self:Watch(player)
	end)
	self.PlayerRemovingConn = Players.PlayerRemoving:Connect(function(player)
		self:DestroyTag(player)
		local conns = self.PlayerConns[player]
		if conns then
			for _, conn in pairs(conns) do
				conn:Disconnect()
			end
			self.PlayerConns[player] = nil
		end
		local statConn = self.StatConns[player]
		if statConn then
			statConn:Disconnect()
			self.StatConns[player] = nil
		end
	end)

	return self
end

function PlayerTags:ResolveColors()
	local theme = self.WindUI and self.WindUI.Theme or nil
	local custom = self.Config.Colors or {}
	self.Colors = {
		Text = custom.Text or colorOf(theme and theme.Text, DEFAULT_TEXT),
		Subtle = custom.Subtle or colorOf(theme and theme.Placeholder, DEFAULT_SUBTLE),
		Accent = custom.Accent or colorOf(theme and theme.Accent, DEFAULT_ACCENT),
		Icon = custom.Icon or colorOf(theme and theme.Icon, DEFAULT_TEXT),
		Background = custom.Background or colorOf(theme and theme.Dialog, DEFAULT_BACKGROUND),
	}
	return self
end

function PlayerTags:RankOf(player)
	return self.Ranks[string.lower(player.Name)] or self.Ranks[tostring(player.UserId)]
end

function PlayerTags:TimeOf(player)
	local stats = player:FindFirstChild("leaderstats")
	local stat = stats and stats:FindFirstChild(self.Config.TimeStat or "Time")
	if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue") or stat:IsA("StringValue")) then
		return stat.Value
	end
	return nil
end

function PlayerTags:FormatTime(value)
	local format = self.Config.TimeFormat
	if type(format) == "function" then
		local ok, text = pcall(format, value)
		if ok and text ~= nil then
			return tostring(text)
		end
	end
	if typeof(value) == "number" then
		return tostring(math.floor(value))
	end
	return tostring(value)
end

function PlayerTags:UpdateTime(player)
	local tag = self.Tags[player]
	if not tag then
		return
	end
	local value = self:TimeOf(player)
	local label = tag:FindFirstChild("TimeText", true)
	if not label then
		return
	end
	local icon = tag:FindFirstChild("TimeIcon", true)
	local show = value ~= nil
	label.Text = show and self:FormatTime(value) or ""
	label.Visible = show
	if icon then
		icon.Visible = show
	end
end

function PlayerTags:BindStat(player)
	local old = self.StatConns[player]
	if old then
		old:Disconnect()
		self.StatConns[player] = nil
	end
	local stats = player:FindFirstChild("leaderstats")
	local stat = stats and stats:FindFirstChild(self.Config.TimeStat or "Time")
	if stat then
		self.StatConns[player] = stat:GetPropertyChangedSignal("Value"):Connect(function()
			self:UpdateTime(player)
		end)
	end
	self:UpdateTime(player)
end

-- Distance handling. A tag at 900 studs is noise, so it shrinks towards
-- Config.MinScale and stops existing entirely past Config.MaxDistance. Scaling
-- the billboard's own offset size keeps the text crisp, which a UIScale cannot
-- do here because the labels live inside a BillboardGui, not a frame.
function PlayerTags:ApplyScale(player, billboard, distance)
	local near = self.Config.NearDistance or DEFAULT_NEAR_DISTANCE
	local far = self.Config.MaxDistance or DEFAULT_MAX_DISTANCE
	local minScale = self.Config.MinScale or DEFAULT_MIN_SCALE

	local scale = 1
	if distance and distance > near and far > near then
		local ratio = math.clamp((distance - near) / (far - near), 0, 1)
		scale = 1 - (1 - minScale) * ratio
	end

	local width = billboard:GetAttribute("WindUI_BaseWidth") or 220
	local height = billboard:GetAttribute("WindUI_BaseHeight") or 84
	billboard.Size = UDim2.fromOffset(math.floor(width * scale), math.floor(height * scale))
end

function PlayerTags:StartScaleLoop()
	if self.ScaleConn then
		return self
	end
	self.ScaleConn = RunService.Heartbeat:Connect(function()
		if not self.Alive then
			return
		end
		local camera = workspace.CurrentCamera
		local origin = camera and camera.CFrame.Position
		for player, billboard in pairs(self.Tags) do
			local adornee = billboard.Adornee
			if not (adornee and adornee:IsDescendantOf(workspace)) then
				continue
			end
			local distance = origin and (adornee.Position - origin).Magnitude or 0
			self:ApplyScale(player, billboard, distance)
		end
	end)
	return self
end

function PlayerTags:StopScaleLoop()
	if self.ScaleConn then
		self.ScaleConn:Disconnect()
		self.ScaleConn = nil
	end
	return self
end

-- Walks the local character to the tagged player. Server-side teleports are not
-- available to a client, so this is a CFrame move: fine in games that trust the
-- client, ignored in games that rubber-band it back.
function PlayerTags:TeleportTo(player)
	if not player or player == self.LocalPlayer then
		return false
	end

	local targetChar = player.Character
	local targetRoot = targetChar
		and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Head"))
	local myChar = self.LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not (targetRoot and myRoot) then
		return false
	end

	-- Land in front of them, facing the same way, so the camera does not spin.
	local target = targetRoot.CFrame
	local destination = CFrame.new(target.Position + target.LookVector * -5 + Vector3.new(0, 3, 0), target.Position)
	myRoot.CFrame = destination
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	if type(self.Config.OnClick) == "function" then
		pcall(self.Config.OnClick, player)
	end
	return true
end

-- Turn the click surface on or off for every tag already on screen. Exposed so
-- the hub can wire it to a toggle without rebuilding the tags.
function PlayerTags:SetClickable(on)
	self.Clickable = on ~= false
	for _, billboard in pairs(self.Tags) do
		local root = billboard:FindFirstChild("TagRoot")
		local click = root and root:FindFirstChild("Click")
		if click then
			click.Visible = self.Clickable
		end
	end
	return self
end

function PlayerTags:BuildTag(player)
	self:DestroyTag(player)

	local rank = self:RankOf(player)
	if not rank then
		return
	end
	if self.Config.ShowSelf == false and player == self.LocalPlayer then
		return
	end

	local char = player.Character
	local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if not head then
		return
	end

	local colors = self.Colors
	local rankKey = string.lower(tostring(rank))
	local rankColor = self.RankColors[rankKey] or colors.Text
	local radius = self.Config.CornerRadius or DEFAULT_CORNER

	local maxDistance = self.Config.MaxDistance or DEFAULT_MAX_DISTANCE
	local baseWidth = self.Config.Width or 220
	local baseHeight = self.Config.Height or 84

	local billboard = New("BillboardGui", {
		Name = "WindUI_PlayerTag",
		Adornee = head,
		Size = UDim2.fromOffset(baseWidth, baseHeight),
		StudsOffset = self.Config.Offset or Vector3.new(0, 3, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = maxDistance,
		Parent = head,
	})
	-- The scale loop needs the untransformed size, otherwise a shrink compounds
	-- every frame and the tag collapses to a dot.
	billboard:SetAttribute("WindUI_BaseWidth", baseWidth)
	billboard:SetAttribute("WindUI_BaseHeight", baseHeight)

	-- Island shadow stack: a wide dark glow and a tight contact shadow. Both
	-- are pcall'd because UIShadow is not available on every client build.
	pcall(function()
		New("UIShadow", {
			Name = "DarkGlow",
			Color = Color3.new(0, 0, 0),
			BlurRadius = UDim.new(0, 24),
			Offset = UDim2.fromOffset(0, 8),
			Transparency = self.Config.ShadowTransparency or 0.45,
			ZIndex = -2,
			Parent = billboard,
		})
		New("UIShadow", {
			Name = "Contact",
			Color = Color3.new(0, 0, 0),
			BlurRadius = UDim.new(0, 8),
			Offset = UDim2.fromOffset(0, 2),
			Transparency = 0.55,
			ZIndex = -1,
			Parent = billboard,
		})
	end)

	local root = New("Frame", {
		Name = "TagRoot",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = colors.Background,
		BackgroundTransparency = self.Config.BackgroundTransparency or 0,
		BorderSizePixel = 0,
		Parent = billboard,
	}, {
		New("UICorner", {
			CornerRadius = UDim.new(0, radius),
		}),
	})

	-- Brand, pinned top-left: hub icon and name on one row.
	local brand = New("Frame", {
		Name = "Brand",
		Position = UDim2.fromOffset(12, 9),
		Size = UDim2.fromOffset(130, 20),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		New("UIListLayout", {
			SortOrder = "LayoutOrder",
			FillDirection = "Horizontal",
			HorizontalAlignment = "Left",
			VerticalAlignment = "Center",
			Padding = UDim.new(0, 6),
		}),
	})

	local iconData = Creator.Icon(self.Config.Icon or DEFAULT_ICON)
	New("ImageLabel", {
		Image = iconData.Image,
		ImageRectOffset = iconData.ImageRectPosition,
		ImageRectSize = iconData.ImageRectSize,
		ImageColor3 = colors.Text,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(18, 18),
		LayoutOrder = 1,
		Parent = brand,
	})
	New("TextLabel", {
		Text = self.Config.Title or "Ender Hub",
		TextColor3 = colors.Text,
		TextSize = 13,
		FontFace = Font.new(Creator.Font, Enum.FontWeight.SemiBold),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(104, 18),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
		Parent = brand,
	})

	-- Status row, pinned top-right: account age + leaderboard time, the same
	-- icon/value pairing the island uses for ping + uptime. Both values are
	-- replicated, so they are correct on every player's tag.
	local status = New("Frame", {
		Name = "Status",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 9),
		Size = UDim2.fromOffset(96, 20),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		New("UIListLayout", {
			SortOrder = "LayoutOrder",
			FillDirection = "Horizontal",
			HorizontalAlignment = "Right",
			VerticalAlignment = "Center",
			Padding = UDim.new(0, 4),
		}),
	})

	local ageIcon = Creator.Icon(self.Config.AgeIcon or "lucide:calendar")
	New("ImageLabel", {
		Name = "AgeIcon",
		Image = ageIcon.Image,
		ImageRectOffset = ageIcon.ImageRectPosition,
		ImageRectSize = ageIcon.ImageRectSize,
		ImageColor3 = colors.Subtle,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(13, 13),
		LayoutOrder = 1,
		Parent = status,
	})
	New("TextLabel", {
		Name = "AgeText",
		Text = AgeText(player.AccountAge),
		TextColor3 = colors.Subtle,
		TextSize = 11,
		FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		LayoutOrder = 2,
		Parent = status,
	})
	New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(4, 1),
		LayoutOrder = 3,
		Parent = status,
	})

	local timeIcon = Creator.Icon(self.Config.TimeIcon or "lucide:clock")
	New("ImageLabel", {
		Name = "TimeIcon",
		Image = timeIcon.Image,
		ImageRectOffset = timeIcon.ImageRectPosition,
		ImageRectSize = timeIcon.ImageRectSize,
		ImageColor3 = colors.Subtle,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(13, 13),
		LayoutOrder = 4,
		Parent = status,
	})
	New("TextLabel", {
		Name = "TimeText",
		Text = "",
		TextColor3 = colors.Subtle,
		TextSize = 11,
		FontFace = Font.new(Creator.Font, Enum.FontWeight.Medium),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		LayoutOrder = 5,
		Parent = status,
	})

	-- Rank is the loudest line; the handle sits under it like a description.
	New("TextLabel", {
		Name = "Rank",
		Position = UDim2.fromOffset(0, 32),
		Text = tostring(rank),
		TextColor3 = rankColor,
		TextSize = self.Config.RankTextSize or 22,
		FontFace = Font.new(Creator.Font, Enum.FontWeight.Bold),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = root,
	})

	New("TextLabel", {
		Name = "Handle",
		Position = UDim2.fromOffset(0, 58),
		Text = "@" .. tostring(player.DisplayName),
		TextColor3 = colors.Subtle,
		TextSize = 11,
		FontFace = Font.new(Creator.Font, Enum.FontWeight.Regular),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 14),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = root,
	})

	-- Click surface. A transparent button over the whole card, so the tag itself
	-- is the target: pressing it walks the local player to that person. It sits
	-- above every label so the rank text cannot swallow the click.
	local click = New("TextButton", {
		Name = "Click",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 10,
		Visible = self.Clickable,
		Parent = root,
	})
	click.MouseButton1Click:Connect(function()
		self:TeleportTo(player)
	end)

	self.Tags[player] = billboard
	self:ApplyScale(player, billboard, 0)
	self:UpdateTime(player)
end

function PlayerTags:DestroyTag(player, char)
	local billboard = self.Tags[player]
	if billboard then
		-- A fast respawn can deliver CharacterRemoving for the old rig after
		-- the new tag already exists; only drop the tag that belongs to it.
		if char and billboard.Adornee and not billboard.Adornee:IsDescendantOf(char) then
			return
		end
		billboard:Destroy()
		self.Tags[player] = nil
	end
end

-- Some games hand CharacterAdded a rig with no Head yet (it is assembled a
-- frame or two later). Poll briefly instead of building once and losing the
-- tag until the next respawn.
function PlayerTags:AttachWhenReady(player, char, attempt)
	if not self.Alive or player.Character ~= char then
		return
	end
	local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if head then
		self:BuildTag(player)
		return
	end
	attempt = attempt or 0
	if attempt >= 200 then
		return
	end
	task.delay(0.05, function()
		self:AttachWhenReady(player, char, attempt + 1)
	end)
end

function PlayerTags:Watch(player)
	if not self.Alive then
		return
	end

	self.PlayerConns[player] = {
		player.CharacterAdded:Connect(function(char)
			task.defer(function()
				if self.Alive then
					self:AttachWhenReady(player, char)
				end
			end)
		end),
		player.CharacterRemoving:Connect(function(char)
			self:DestroyTag(player, char)
		end),
		player.ChildAdded:Connect(function(child)
			if child.Name == "leaderstats" then
				task.defer(function()
					if self.Alive then
						self:BindStat(player)
					end
				end)
			end
		end),
	}

	self:BindStat(player)
	if player.Character then
		self:AttachWhenReady(player, player.Character)
	end
end

function PlayerTags:Scan()
	for _, player in ipairs(Players:GetPlayers()) do
		self:Watch(player)
	end
	return self
end

-- Rebuild every tag against the current theme / rank table.
function PlayerTags:Refresh()
	self:ResolveColors()
	for _, player in ipairs(Players:GetPlayers()) do
		self:BuildTag(player)
	end
	return self
end

function PlayerTags:SetRank(name, rank)
	local key = string.lower(tostring(name or ""))
	if key == "" then
		return self
	end
	if rank == nil then
		self.Ranks[key] = nil
	else
		self.Ranks[key] = rank
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if string.lower(player.Name) == key then
			self:BuildTag(player)
		end
	end
	return self
end

function PlayerTags:Destroy()
	self.Alive = false
	self:StopScaleLoop()
	if self.PlayerAddedConn then
		self.PlayerAddedConn:Disconnect()
	end
	if self.PlayerRemovingConn then
		self.PlayerRemovingConn:Disconnect()
	end
	for player, conns in pairs(self.PlayerConns) do
		for _, conn in pairs(conns) do
			conn:Disconnect()
		end
		self.PlayerConns[player] = nil
	end
	for player, conn in pairs(self.StatConns) do
		conn:Disconnect()
		self.StatConns[player] = nil
	end
	for player in pairs(self.Tags) do
		self:DestroyTag(player)
	end
end

return PlayerTags
end

__modules["src/components/window/DynamicIsland.lua"] = function(require)
-- DynamicIsland - the pill at the top of the screen and the card it opens into.
--
--   local Island = WindUI:DynamicIsland({
--       Providers = { "files", "spotify", "demo" },
--       Folder = "Ender Hub/songs",
--   })
--
--   -- docked inside a window instead of floating over the game:
--   local Island = WindUI:DynamicIsland({ Parent = Tab.Frame })
--
-- Ported from the Novoline island: the shell is a 212 x 40 capsule with 28 px
-- artwork at (6, 6) and six 2 px bars on the right edge. Tapped it springs to
-- 476 x 204 (752 wide with the sources pane open): header strip with the source
-- and the ping, a 288 x 96 now-playing card with 72 px artwork, a 176 x 120 chip
-- grid, a 448 x 50 scrubber card with the transport, and the 360 x 154 sources
-- pane. Every size is a spring, every section fades in on a stagger, and the
-- cover morphs between the pill size and the card size on the same curve the
-- reference uses. Service plumbing lives in modules/MusicProviders.

local cloneref = (cloneref or clonereference or function(instance)
	return instance
end)

local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))
local Stats = cloneref(game:GetService("Stats"))
local AssetService = cloneref(game:GetService("AssetService"))

local Creator = require("src/modules/Creator.lua")
local Surface = require("src/modules/MusicSurface.lua")

local New = Creator.New
local Tween = Creator.Tween

local Medium = Font.new(Creator.Font, Enum.FontWeight.Medium)
local Bold = Font.new(Creator.Font, Enum.FontWeight.Bold)

-- Pure colour maths lives at module scope: New() is already at the Luau
-- 200-register ceiling, and every local declared inside it costs a slot.
local function Luminance(Color)
	return 0.2126 * Color.R + 0.7152 * Color.G + 0.0722 * Color.B
end

local function TooDark(Color)
	return type(Color) == "Color3" and Luminance(Color) < 0.16
end

-- Sleeve pixels skew dark, and a dark bar on a dark pill disappears. Mix the
-- sampled colour toward white so the hue survives but the bar reads at a
-- glance. 0 keeps the raw pixel, 1 is pure white.
local function Lift(Color, Amount)
	if type(Color) ~= "Color3" then
		return Color3.new(1, 1, 1)
	end
	return Color3.new(
		Color.R + (1 - Color.R) * Amount,
		Color.G + (1 - Color.G) * Amount,
		Color.B + (1 - Color.B) * Amount
	)
end

local DynamicIsland = {}
DynamicIsland.__index = DynamicIsland

--------------------------------------------------------------------------
-- metrics, straight off the reference
--------------------------------------------------------------------------

local W, SW, AW, P = 476, 276, 288, 14
local SX, SWW = 378, 360
local HE, HC = 204, 40

local PILL_W, PILL_H = 212, 40
local BW = W - P * 2

-- Loading is a card, not a capsule: the same footprint as the mini strip, so
-- the label, the line under it and the bar all have room to breathe.
local LOAD_W, LOAD_H = 340, 88

-- Toasts ride the same surface as every other element: a card a touch
-- smaller than the mini strip, with an icon tile, a title and a line.
local TOAST_W, TOAST_H = 300, 76

-- Tool strip: the game's own mode label and mode button, moved into the
-- capsule. Label on top, button under it, the exact order the game draws.
local TOOL_W, TOOL_H = 280, 84

-- The key prompt fills the card the player does: same width and height, so
-- switching between the two never resizes the capsule and the card never
-- carries a dead band where the music header used to be.
local KEY_W, KEY_H = W, HE
local KEY_Y = 0

-- Palette the island paints with. New() overrides these from Config.Palette,
-- Config.Accent and the active WindUI theme before any element is built, so a
-- host script can restyle the capsule without touching this file.
local DEFAULT_PALETTE = {
	Ink = Color3.new(1, 1, 1),
	Subtle = Color3.fromRGB(154, 156, 164),
	Accent = Color3.fromRGB(110, 220, 170),
	Green = Color3.fromRGB(52, 199, 89),
	Red = Color3.fromRGB(255, 92, 92),
	Background = Color3.new(0, 0, 0),
}

local Palette = table.clone(DEFAULT_PALETTE)

-- Resolve the palette before anything is built: Config.Palette wins, the
-- active theme fills Ink/Subtle/Background, and the module defaults cover the
-- rest. Accent keeps the hub green unless pinned, because the fork's theme
-- Accent is a surface colour (near-black in Dark) and would vanish on the pill.
-- Kept at module scope because DynamicIsland.New is already at the 200-register
-- ceiling and three more locals there stop the bundle compiling.
local function ResolvePalette(Config)
	local Theme = Config.WindUI and Config.WindUI.Theme or nil
	local Custom = Config.Palette or {}
	local function ThemeColor(Key, Fallback)
		local Value = Theme and Theme[Key]
		if typeof(Value) == "Color3" then
			return Value
		end
		if type(Value) == "table" and Value.Color then
			local Points = Value.Color.Keypoints
			if Points and Points[1] then
				return Points[1].Value
			end
		end
		return Fallback
	end

	local Next_ = table.clone(DEFAULT_PALETTE)
	Next_.Ink = Custom.Ink or ThemeColor("Text", Next_.Ink)
	Next_.Subtle = Custom.Subtle or ThemeColor("Placeholder", Next_.Subtle)
	Next_.Accent = Config.Accent or Custom.Accent or Next_.Accent
	Next_.Green = Custom.Green or Next_.Green
	Next_.Red = Custom.Red or Next_.Red
	Next_.Background = Custom.Background or ThemeColor("Background", Next_.Background)
	return Next_
end

-- The bench is monochrome: the only colour on screen comes from the artwork.
local TINT = {
