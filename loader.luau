			end
			for Index = 1, 3 do
				New("Frame", {
					Parent = Preview,
					Position = UDim2.fromOffset(76, 44 + (Index - 1) * 30),
					Size = UDim2.fromOffset(Index == 3 and 92 or 148, 22),
					BackgroundColor3 = Color3.new(1, 1, 1),
