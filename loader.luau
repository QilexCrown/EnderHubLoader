			Cols = 10,
		},
	}

	function Toggle:GetGlassFrame(T: number): (string, Vector2, Vector2)
		local S = Toggle.GlassSpritesheet
		local Frame: number

		if T <= 0.4 then
			Frame = math.floor((T / 0.4) * (S.Total - 1))
		elseif T < 0.6 then
			Frame = S.Total - 1
		else
			Frame = math.floor(((T - 0.6) / 0.4) * (S.Total - 1))
